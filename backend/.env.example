# Copiar a .env para desarrollo local. En Render, crear estas variables
# desde Settings > Environment del servicio backend.
DB_HOST=hostname-del-proveedor
DB_PORT=4000
DB_USER=usuario-de-la-base
DB_PASSWORD=coloca-la-clave-en-el-entorno
DB_NAME=nombre-de-la-base
# Ruta al certificado CA descargado, dentro del backend; opcional si se usa DB_SSL.
DB_CA_PATH=
DB_SSL=true
PORT=4000
