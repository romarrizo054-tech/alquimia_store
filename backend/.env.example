# Copiar a .env para desarrollo local. En Render, crear estas variables
# desde Settings > Environment del servicio backend.
DB_HOST=hostname-del-proveedor
DB_PORT=4000
DB_USER=usuario-de-la-base
DB_PASSWORD=coloca-la-clave-en-el-entorno
DB_NAME=nombre-de-la-base
# Ruta al certificado CA descargado, dentro del backend; opcional.
DB_CA_PATH=
# Las bases remotas siempre usan TLS; DB_SSL=false solo aplica a MySQL local.
DB_SSL=true
PORT=4000
FRONTEND_URL=https://alquimia-store-1.onrender.com
ADMIN_PASSWORD=define-una-clave-larga-y-unica
ADMIN_SESSION_SECRET=define-otro-secreto-largo-y-aleatorio
# CLOUDINARY_URL es un secreto del backend; copiarlo desde la consola de Cloudinary.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Si no usas Cloudinary, Render requiere un disco persistente y esta ruta montada.
UPLOADS_DIR=/var/data/uploads
